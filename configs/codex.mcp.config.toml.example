# Example Codex MCP configuration for ICViewer development.
# Merge into ~/.codex/config.toml and replace placeholder paths as needed.

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

[mcp_servers.filesystem]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "/aialra/ICViewer/repo"]

# Optional GitHub MCP. Prefer least-privilege repo and actions scopes only.
# [mcp_servers.github]
# command = "docker"
# args = [
#   "run", "-i", "--rm",
#   "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
#   "ghcr.io/github/github-mcp-server"
# ]
# env = { GITHUB_PERSONAL_ACCESS_TOKEN = "YOUR_TOKEN" }
