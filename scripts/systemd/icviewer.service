[Unit]
Description=ICViewer FastAPI backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/icviewer/apps/api
EnvironmentFile=-/etc/icviewer.env
ExecStart=/opt/icviewer/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 34000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
